# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，不要提交。

# 服务端独占的数据库连接。客户端不使用此连接串。
# 本机约定:brew postgresql@14 跑 5433(5432 被系统级 PostgreSQL 18 占用)。
DATABASE_URL=postgres://pacs:CHANGE_ME@127.0.0.1:5433/pacs

# 集成测试专用库。测试会写入真实数据，不要指向开发库。
# 建库：createdb -h 127.0.0.1 -p 5433 -U sunyulin -O pacs pacs_test
PACS_TEST_DATABASE_URL=postgres://pacs:CHANGE_ME@127.0.0.1:5433/pacs_test

# 影像文件存储根目录（像素数据存文件系统，数据库只存索引）
PACS_STORAGE_ROOT=./data/storage

# DIMSE 监听。默认只绑回环地址；改成 0.0.0.0 之前请先完成账号体系与 TLS。
PACS_DIMSE_BIND=127.0.0.1:11112
PACS_AE_TITLE=REMOTE_PACS

# HTTP/DICOMweb 监听
PACS_HTTP_BIND=127.0.0.1:8443

# access token 签名密钥。用 `openssl rand -base64 48` 生成，切勿使用默认值。
PACS_JWT_SECRET=CHANGE_ME

RUST_LOG=info,pacsd=debug

# ---- docker compose 覆盖项（可选）----
# docker compose 会读取根目录 .env 里的同名变量；不设则用 docker-compose.yml 内默认值。
# POSTGRES_USER=pacs
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=pacs
# PACS_JWT_SECRET=用 openssl rand -base64 48 生成
# PACS_ADMIN_USERNAME=admin
# PACS_ADMIN_PASSWORD=replace-with-a-strong-password
# PACS_HTTP_PORT=8443
# PACS_DIMSE_PORT=11112
# SIMULATOR_PORT=8787
# 注意：密码避免 @ : 等字符，会破坏 DATABASE_URL 连接串。
