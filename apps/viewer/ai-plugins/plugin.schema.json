{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheris.local/schemas/ai-plugin-v1.json",
  "title": "AETHERIS AI Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "name", "version", "worker_protocol", "launcher"],
  "properties": {
    "manifest_version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "worker_protocol": { "const": 1 },
    "launcher": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "script"],
          "properties": {
            "kind": { "const": "python" },
            "script": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "executable" },
            "path": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      ]
    }
  }
}
