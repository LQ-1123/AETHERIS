{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AETHERIS",
  "version": "0.1.0",
  "identifier": "cn.local.remote-pacs.viewer",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AETHERIS | Medical Imaging Cloud",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:allow-message",
            "dialog:allow-ask",
            "dialog:allow-confirm"
          ]
        }
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' pacs-frame: http://pacs-frame.localhost pacs-volume: http://pacs-volume.localhost ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "AETHERIS Medical Imaging Cloud",
    "shortDescription": "AETHERIS DICOM 影像查看器",
    "longDescription": "AETHERIS Medical Imaging Cloud 的桌面查看器,可连接服务端或直接打开本地 DICOM 文件。"
  }
}
